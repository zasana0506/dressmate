# 默认按文本处理，检出时统一用 LF
* text=auto eol=lf

# Windows 批处理必须是 CRLF，否则双击没反应
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制，不做行尾转换
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.gif binary
*.ico binary

# 脚本必须是 LF，否则在 Linux 容器里会报 "no such file or directory"
*.sh text eol=lf
docker-entrypoint.sh text eol=lf
